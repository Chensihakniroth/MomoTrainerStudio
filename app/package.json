{
  "name": "momotrainer-studio",
  "version": "1.0.0",
  "description": "MomoTrainer Studio - Modern Electron + React UI",
  "main": "electron/main.js",
  "homepage": "./",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.momotrainer.studio",
    "productName": "MomoTrainer Studio",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "python_backend.py",
      "memory_scanner.py",
      "trainer_compiler.py",
      "debugger.py",
      "stealth_debugger.py",
      "themes.py"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
